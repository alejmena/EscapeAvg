# Copia este archivo a .env.local y rellena los valores de tu proyecto Supabase
# (Supabase Dashboard → Project Settings → API).
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Sirve la clave "anon" (JWT) o la nueva "publishable" (sb_publishable_...).
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# URL pública de la app (para los enlaces de confirmación de email).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Solo para pruebas de base de datos (npm run test:db): un Postgres vacío con superusuario.
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/escapeavg_test
